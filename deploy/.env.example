DOMAIN=sicac.duckdns.org

APP_NAME=SICAC
APP_KEY=base64:REEMPLAZAR_CON_APP_KEY

SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=sicac.duckdns.org
FRONTEND_URLS=https://sicac.duckdns.org

# Que archivo de Caddy usar: Caddyfile (https) o Caddyfile.http (solo http)
CADDYFILE=Caddyfile

# Recomendado para ACME/Let's Encrypt
CADDY_EMAIL=tuemail@algo.com

SEED_DEMO_DATA=true

# NO usar nip.io en produccion: Let's Encrypt lo rate-limitea y rompe HTTPS.
# IA (si no pones key, los endpoints IA basados en LLM van a fallar)
GPT_API_KEY=
OPENAI_API_KEY=
