{
    "name": "sicac_frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api\" \"npm run dev:ai\" --kill-others --names frontend,api,ai --prefix-colors cyan,green,yellow",
        "dev:frontend": "vite",
        "dev:api": "php ../sicac_backend/artisan config:clear && php ../sicac_backend/artisan serve --host=127.0.0.1 --port=8001",
        "dev:ai": "python \"IA/kill_port.py\" && python \"IA/main.py\"",
        "dev:backend": "npm run dev:ai",
        "setup:api": "php ../sicac_backend/artisan migrate --seed",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@iconify/vue": "^5.0.0",
        "@internationalized/date": "^3.10.1",
        "@tailwindcss/vite": "^4.1.17",
        "@tanstack/vue-table": "^8.21.3",
        "@vee-validate/zod": "^4.15.1",
        "@vueuse/core": "^14.1.0",
        "axios": "^1.13.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "embla-carousel-autoplay": "^8.6.0",
        "embla-carousel-vue": "^8.6.0",
        "jspdf": "^3.0.4",
        "jspdf-autotable": "^5.0.2",
        "lucide-vue-next": "^0.555.0",
        "pinia": "^3.0.4",
        "reka-ui": "^2.8.0",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.17",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.24",
        "vue-router": "^4.6.3",
        "vue-sonner": "^2.0.9",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@iconify/vue": "^5.0.0",
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.8.1",
        "concurrently": "^9.2.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.9.3",
        "vite": "^7.2.4",
        "vue-tsc": "^3.1.4"
    }
}
